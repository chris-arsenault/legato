[common.tracing]
json = true
level = "info"
log_dir = "/var/lib/legato/logs"

[common.metrics]
bind_address = "0.0.0.0:9464"
prefix = "legato_server"

[server]
bind_address = "0.0.0.0:7823"
library_root = "/srv/libraries"
state_dir = "/var/lib/legato"
tls_dir = "/etc/legato/certs"

[server.tls]
cert_path = "/etc/legato/certs/server.pem"
key_path = "/etc/legato/certs/server-key.pem"
client_ca_path = "/etc/legato/certs/client-ca.pem"
server_names = ["192.168.66.3", "localhost", "legato-server"]

[server.bootstrap]
enabled = true
bind_address = "0.0.0.0:7824"
discovery_bind_address = "0.0.0.0:7825"
advertised_endpoint = "192.168.66.3:7823"
advertised_bootstrap_url = "http://192.168.66.3:7824"
server_name = "192.168.66.3"
