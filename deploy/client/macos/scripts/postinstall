#!/bin/bash
set -euo pipefail

STATE_DIR="/Library/Application Support/Legato"
CERT_DIR="${STATE_DIR}/certs"
CONFIG_EXAMPLE="${STATE_DIR}/legatofs.toml.example"
CONFIG_PATH="${STATE_DIR}/legatofs.toml"
CERT_README="${CERT_DIR}/README.txt"
INSTALL_LOG="${STATE_DIR}/logs/install.log"
MOUNT_POINT="${LEGATO_MOUNT_POINT:-/Volumes/Legato}"
LIBRARY_ROOT="${LEGATO_LIBRARY_ROOT:-/}"
SERVICE_LABEL="com.legato.legatofs"

mkdir -p "${STATE_DIR}" "${CERT_DIR}" "${STATE_DIR}/catalog" "${STATE_DIR}/segments" "${STATE_DIR}/checkpoints" "${STATE_DIR}/logs"
exec >> "${INSTALL_LOG}" 2>&1

echo "Legato postinstall started at $(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')"

if [ -f "${STATE_DIR}/certs-README.txt" ] && [ ! -f "${CERT_README}" ]; then
  mv "${STATE_DIR}/certs-README.txt" "${CERT_README}"
fi

if [ -f "${CONFIG_EXAMPLE}" ] && [ ! -f "${CONFIG_PATH}" ]; then
  cp "${CONFIG_EXAMPLE}" "${CONFIG_PATH}"
fi

chmod 755 /usr/local/bin/legatofs
chmod 755 /usr/local/bin/legato-register-client
chmod 755 /usr/local/bin/legato-setup-client
chmod 755 "${STATE_DIR}"
chmod 700 "${CERT_DIR}"

console_user() {
  /usr/bin/stat -f %Su /dev/console 2>/dev/null || true
}

console_home() {
  /usr/bin/dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | /usr/bin/sed 's/^NFSHomeDirectory: //' || true
}

client_config_ready() {
  [ -f "${CONFIG_PATH}" ] &&
    [ -f "${CERT_DIR}/server-ca.pem" ] &&
    [ -f "${CERT_DIR}/client.pem" ] &&
    [ -f "${CERT_DIR}/client-key.pem" ]
}

require_console_user() {
  local user="$1"
  if [ -z "${user}" ] || [ "${user}" = "root" ] || [ "${user}" = "loginwindow" ]; then
    echo "error: Legato macOS install requires an interactive console user for the launchd agent."
    exit 1
  fi
}

prepare_state_owner() {
  local user="$1"
  /usr/sbin/chown -R "${user}:staff" "${STATE_DIR}"
  /bin/chmod 755 "${STATE_DIR}"
  /bin/chmod 700 "${CERT_DIR}"
}

run_as_console_user() {
  local user="$1"
  local uid="$2"
  local home="$3"
  if [ -z "${home}" ]; then
    home="/Users/${user}"
  fi

  /bin/launchctl asuser "${uid}" /usr/bin/sudo -u "${user}" /usr/bin/env HOME="${home}" "$@"
}

stop_launchd_agent() {
  local uid="$1"
  /bin/launchctl bootout "gui/${uid}/${SERVICE_LABEL}" || true
}

bootstrap_client() {
  local client_name="$1"
  local args=(
    install
    --client-name "${client_name}"
    --mount-point "${MOUNT_POINT}"
    --state-dir "${STATE_DIR}"
    --library-root "${LIBRARY_ROOT}"
    --force
  )

  if [ -n "${LEGATO_BOOTSTRAP_URL:-}" ]; then
    args+=(--bootstrap-url "${LEGATO_BOOTSTRAP_URL}")
  fi

  /usr/local/bin/legatofs "${args[@]}"
}

CONSOLE_USER="$(console_user)"
require_console_user "${CONSOLE_USER}"
CONSOLE_UID="$(/usr/bin/id -u "${CONSOLE_USER}")"
CONSOLE_HOME="$(console_home "${CONSOLE_USER}")"
if [ -z "${CONSOLE_HOME}" ]; then
  CONSOLE_HOME="/Users/${CONSOLE_USER}"
fi

CLIENT_NAME="${LEGATO_CLIENT_NAME:-$(/usr/sbin/scutil --get LocalHostName 2>/dev/null || /bin/hostname)}"

stop_launchd_agent "${CONSOLE_UID}"

if client_config_ready; then
  echo "Existing Legato client config and certs found; preserving registration."
else
  echo "No complete Legato client registration found; bootstrapping client ${CLIENT_NAME}."
  bootstrap_client "${CLIENT_NAME}"
fi

prepare_state_owner "${CONSOLE_USER}"
run_as_console_user "${CONSOLE_USER}" "${CONSOLE_UID}" "${CONSOLE_HOME}" /usr/local/bin/legatofs service install --force
run_as_console_user "${CONSOLE_USER}" "${CONSOLE_UID}" "${CONSOLE_HOME}" /usr/local/bin/legatofs service start

echo "Legato postinstall completed."

exit 0
